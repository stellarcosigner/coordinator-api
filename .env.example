# --- Server ---
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info

# --- Database (Postgres) ---
DATABASE_URL=postgres://coordinator:coordinator@localhost:5432/coordinator

# --- Stellar network endpoints (public defaults) ---
TESTNET_HORIZON_URL=https://horizon-testnet.stellar.org
MAINNET_HORIZON_URL=https://horizon.stellar.org

# --- Request lifecycle ---
# Default time-to-live for a pending request when the client does not specify one (seconds). Default: 7 days.
DEFAULT_TTL_SECONDS=604800
# Upper bound on client-supplied TTL (seconds). Default: 30 days.
MAX_TTL_SECONDS=2592000
# How often the background job runs (ms): marks expired requests, retries submissions, hard-deletes old expired rows. Default: 15 minutes.
EXPIRE_JOB_INTERVAL_MS=900000
# How long an expired request row is retained before hard deletion (seconds). Default: 30 days.
EXPIRED_RETENTION_SECONDS=2592000
# Max network submission attempts per request before giving up (the request then sits pending until its TTL). Default: 5.
MAX_SUBMIT_ATTEMPTS=5

# --- Optional CORS ---
# Comma-separated list of origins allowed to call this API from a browser. Leave empty to disable CORS entirely.
# e.g. CORS_ORIGIN=https://coordinator.example.com
CORS_ORIGIN=
