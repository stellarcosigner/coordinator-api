{
  "name": "@stellarquorum/coordinator-api",
  "version": "0.1.0",
  "description": "Backend for a self-hosted Stellar multisig transaction coordinator. Coordinates signatures from multiple signers and submits once the account's real on-chain threshold is met. Never holds private keys.",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "tsx src/migrate.ts"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@stellar/stellar-sdk": "^16.2.0",
    "fastify": "^5.11.2",
    "pg": "^8.22.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.2",
    "@types/pg": "^8.20.3",
    "eslint": "^10.8.0",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.23.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.66.0",
    "vitest": "^4.1.10"
  }
}
